DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formmaker
SECRET_KEY=ganti-dengan-random-string-panjang-dan-rahasia
BASE_URL=http://localhost:8000
FRONTEND_URL=https://formax-seven.vercel.app
# Daftar origin yang boleh akses API (pisahkan koma), kosongkan untuk allow all (dev/ngrok)
ALLOWED_ORIGINS=https://formax-seven.vercel.app,http://localhost:5173,http://localhost:3000
# Saat deploy ke Vercel, isi FRONTEND_URL dengan URL Vercel agar QR encode link yang benar
# Contoh: FRONTEND_URL=https://formax-seven.vercel.app
# Gemini AI untuk Formax AI — jangan commit key asli
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
